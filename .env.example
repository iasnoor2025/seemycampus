# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seemycampus

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# AI Provider (Custom - configure based on your provider)
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://api.example.com/v1
AI_PROVIDER=custom

# Optional: OpenAI (if using OpenAI)
# OPENAI_API_KEY=your-openai-api-key

# Optional: Anthropic (if using Anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# App
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
